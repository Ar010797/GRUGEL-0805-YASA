rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ar01071997@gmail.com';
    }

    function hasAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function normCodeStr(val) {
      return val is string
        ? val.trim().upper()
            .replace('^(RT|RW)[\\s.:_-]*', '')
            .replace('\\s*[/,-]?\\s*(RW|RT)[\\s.:_-]*.*$', '')
            .replace('^0+', '')
        : '';
    }

    function sameCode(a, b) {
      return a == b || (
        a is string && b is string &&
        normCodeStr(a) != '' &&
        normCodeStr(a) == normCodeStr(b)
      );
    }

    function isServerAnyRW() {
      return isBootstrappedAdmin() || (hasAdminDoc() && adminDoc().status == 'aktif' && adminDoc().role == 'server');
    }

    function isActiveAdmin() {
      return isBootstrappedAdmin() || (hasAdminDoc() && adminDoc().status == 'aktif');
    }

    function isActiveAdminInRW(rw) {
      return isBootstrappedAdmin() || (hasAdminDoc() && adminDoc().status == 'aktif' && (adminDoc().rw == rw || sameCode(adminDoc().rw, rw)));
    }

    function isServerInRW(rw) {
      return isBootstrappedAdmin() || (hasAdminDoc() && adminDoc().status == 'aktif' && adminDoc().role == 'server' && (adminDoc().rw == rw || sameCode(adminDoc().rw, rw)));
    }

    function isAssignedAdmin(rw, rt) {
      return isBootstrappedAdmin() || (
        hasAdminDoc() &&
        adminDoc().status == 'aktif' &&
        (adminDoc().rw == rw || sameCode(adminDoc().rw, rw)) &&
        (adminDoc().role == 'server' || ((adminDoc().rt == rt || sameCode(adminDoc().rt, rt)) && rt != 'SEMUA'))
      );
    }

    function isAssignedAdminReadSetting(rw, rt) {
      return isBootstrappedAdmin() || (
        hasAdminDoc() &&
        adminDoc().status == 'aktif' &&
        (adminDoc().rw == rw || sameCode(adminDoc().rw, rw)) &&
        (adminDoc().role == 'server' || adminDoc().rt == rt || sameCode(adminDoc().rt, rt) || rt == 'SEMUA')
      );
    }

    function hasWargaProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/wargaProfiles/$(request.auth.uid));
    }

    function wargaProfile() {
      return get(/databases/$(database)/documents/wargaProfiles/$(request.auth.uid)).data;
    }

    function isWargaInRWRT(rw, rt) {
      return hasWargaProfile() &&
        (wargaProfile().rw == rw || sameCode(wargaProfile().rw, rw)) &&
        (wargaProfile().rt == rt || sameCode(wargaProfile().rt, rt));
    }

    function canListOwnOrScoped() {
      return isBootstrappedAdmin() || (
        isSignedIn() && (
          request.auth.uid in resource.data.accessUids ||
          resource.data.ownerUid == request.auth.uid
        )
      );
    }

    function canListOwnerScoped() {
      return isBootstrappedAdmin() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      );
    }

    function isValidStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptStr(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptNum(data, key) {
      return !(key in data) || data[key] == null || (data[key] is number);
    }

    function isOptBool(data, key) {
      return !(key in data) || data[key] == null || (data[key] is bool);
    }

    function isOptMap(data, key) {
      return !(key in data) || data[key] == null || (data[key] is map);
    }

    function isValidRwScope(data) {
      return !('rwId' in data) || (
        data.rwId is string && (
          data.rwId == 'rw_' + data.rw ||
          (data.rw is string && data.rw.size() == 1 && data.rwId == 'rw_0' + data.rw) ||
          (data.rwId.matches('^rw_[a-zA-Z0-9]+$') && sameCode(data.rwId.replace('^rw_', ''), data.rw))
        )
      );
    }

    function isValidRwRtScope(data) {
      return isValidRwScope(data) && (
        !('rtId' in data) ||
        (data.rtId is string && (
          (data.rt == 'SEMUA' && data.rtId == 'SEMUA') ||
          (data.rt != 'SEMUA' && (
            data.rtId == 'rt_' + data.rt ||
            (data.rt is string && data.rt.size() == 1 && data.rtId == 'rt_0' + data.rt) ||
            (data.rtId.matches('^rt_[a-zA-Z0-9]+$') && sameCode(data.rtId.replace('^rt_', ''), data.rt))
          ))
        ))
      );
    }

    function hasRequiredScopeIds(data) {
      return ('rwId' in data) && ('rtId' in data);
    }

    function isValidAccessUids(data) {
      return ('accessUids' in data) &&
        data.accessUids is list &&
        data.accessUids.size() >= 1 &&
        data.accessUids.size() <= 15 &&
        data.accessUids[0] is string;
    }

    function isValidPinDigest(pinDigest) {
      return (
        exists(/databases/$(database)/documents/systemMeta/pinPolicy) &&
        get(/databases/$(database)/documents/systemMeta/pinPolicy).data.bootstrapDigest == pinDigest
      ) || (
        !exists(/databases/$(database)/documents/systemMeta/pinPolicy) &&
        pinDigest == '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92'
      );
    }

    function isValidServerBootstrapDigest(digest) {
      return digest == '094e1ae6c754564db66e5377b0e59d9a1c3ea6bff31034d55e5c5febf9f71f6f';
    }

    // Entity validation helpers (no existing() or diff() inside)
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'rt', 'rw', 'status', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'role', 'rt', 'rw', 'rtId', 'rwId',
          'rtScope', 'status', 'pinDigest', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidStr(data.email, 3, 254) &&
        isOptStr(data, 'displayName', 160) &&
        isOptStr(data, 'username', 80) &&
        (data.role == 'server' || data.role == 'admin') &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'rtScope', 64) &&
        (data.status == 'aktif' || data.status == 'nonaktif') &&
        isOptStr(data, 'pinDigest', 64) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWargaProfile(data) {
      return data.keys().hasAll(['uid', 'wargaId', 'noKK', 'nama', 'rt', 'rw', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'wargaId', 'noKK', 'nama', 'rt', 'rw', 'rtId', 'rwId', 'ownerUid', 'serverUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.wargaId) &&
        isValidStr(data.noKK, 1, 32) &&
        isValidStr(data.nama, 1, 160) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isValidId(data.ownerUid) &&
        isOptStr(data, 'serverUid', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSystemMeta(data) {
      return data.keys().hasAll(['id', 'serverUid', 'rw', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'serverUid', 'rw', 'rwId', 'bootstrapDigest', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.serverUid) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwScope(data) &&
        isOptStr(data, 'bootstrapDigest', 64) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRtRegistry(data) {
      return data.keys().hasAll(['id', 'rw', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'rw', 'rwId', 'serverUid', 'adminsByRt', 'registeredRts', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwScope(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptMap(data, 'adminsByRt') &&
        (!( 'registeredRts' in data ) || data.registeredRts == null || (data.registeredRts is list && data.registeredRts.size() <= 100 && (data.registeredRts.size() == 0 || data.registeredRts[0] is string))) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRtManifest(data) {
      return data.keys().hasAll(['id', 'rw', 'rt', 'docIds', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'rw', 'rt', 'rtId', 'rwId', 'docIds', 'ownerUid', 'serverUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidStr(data.rw, 1, 10) &&
        isValidStr(data.rt, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        data.docIds is map &&
        isValidId(data.ownerUid) &&
        isOptStr(data, 'serverUid', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRtPublicSummary(data) {
      return data.keys().hasAll(['id', 'rw', 'rt', 'tahunAktif', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'rw', 'rt', 'rtId', 'rwId', 'tahunAktif', 'pengaturanKas', 'transactions', 'pengumuman',
          'ownerUid', 'serverUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.rw, 1, 10) &&
        isValidStr(data.rt, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        data.tahunAktif is number &&
        isOptMap(data, 'pengaturanKas') &&
        (!( 'transactions' in data ) || data.transactions == null || (data.transactions is list && data.transactions.size() <= 2000 && (data.transactions.size() == 0 || data.transactions[0] is map))) &&
        (!( 'pengumuman' in data ) || data.pengumuman == null || (data.pengumuman is list && data.pengumuman.size() <= 200 && (data.pengumuman.size() == 0 || data.pengumuman[0] is map))) &&
        isValidId(data.ownerUid) &&
        isOptStr(data, 'serverUid', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['id', 'rw', 'rt', 'tahunAktif', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'rw', 'rt', 'rtId', 'rwId', 'tahunAktif', 'nominalJimpitanTahunan', 'nominalJimpitanBulanan',
          'nominalKematianTahunan', 'nominalKematianBulanan',
          'saldoAwalKasUmum', 'saldoAwalKasKematian',
          'keteranganSaldoAwal', 'tanggalSaldoAwal',
          'kontakKetuaRT', 'kontakBendahara', 'saldoBerlanjutPerTahun', 'profilRT',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.rw, 1, 10) &&
        isValidStr(data.rt, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        data.tahunAktif is number &&
        isOptNum(data, 'nominalJimpitanTahunan') &&
        isOptNum(data, 'nominalJimpitanBulanan') &&
        isOptNum(data, 'nominalKematianTahunan') &&
        isOptNum(data, 'nominalKematianBulanan') &&
        isOptNum(data, 'saldoAwalKasUmum') &&
        isOptNum(data, 'saldoAwalKasKematian') &&
        isOptStr(data, 'keteranganSaldoAwal', 300) &&
        isOptStr(data, 'tanggalSaldoAwal', 32) &&
        isOptMap(data, 'kontakKetuaRT') &&
        isOptMap(data, 'kontakBendahara') &&
        isOptMap(data, 'saldoBerlanjutPerTahun') &&
        isOptMap(data, 'profilRT') &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWarga(data) {
      return data.keys().hasAll(['id', 'nama', 'rt', 'rw', 'jenisKelamin', 'statusIuran', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'no', 'nama', 'noKK', 'nik', 'noRumah', 'rt', 'rw', 'rtId', 'rwId', 'alamat',
          'kodePos', 'tanggalDikeluarkan', 'jenisKelamin', 'jumlahJiwa', 'statusIuran',
          'anggotaKeluarga', 'telepon', 'pin', 'pinAttempts', 'pinLockedUntil',
          'riwayatIuran', 'riwayatKematian', 'statusIuranPerTahun', 'riwayatIuranPerTahun',
          'riwayatKematianPerTahun', 'iuranUmumTerbayar', 'iuranKematianTerbayar',
          'pilihanSkema', 'riwayatPerubahanKK', 'linkedUid',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isOptNum(data, 'no') &&
        isValidStr(data.nama, 1, 160) &&
        isOptStr(data, 'noKK', 32) &&
        isOptStr(data, 'nik', 32) &&
        isOptStr(data, 'noRumah', 32) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'alamat', 300) &&
        isOptStr(data, 'kodePos', 12) &&
        isOptStr(data, 'tanggalDikeluarkan', 32) &&
        (data.jenisKelamin == 'Laki-laki' || data.jenisKelamin == 'Perempuan') &&
        isOptNum(data, 'jumlahJiwa') &&
        (data.statusIuran == 'Sudah' || data.statusIuran == 'Belum') &&
        (!( 'anggotaKeluarga' in data ) || data.anggotaKeluarga == null || (data.anggotaKeluarga is list && data.anggotaKeluarga.size() <= 30 && (data.anggotaKeluarga.size() == 0 || data.anggotaKeluarga[0] is map))) &&
        isOptStr(data, 'telepon', 32) &&
        isOptStr(data, 'pin', 12) &&
        isOptNum(data, 'pinAttempts') &&
        isOptNum(data, 'pinLockedUntil') &&
        isOptMap(data, 'riwayatIuran') &&
        isOptMap(data, 'riwayatKematian') &&
        isOptMap(data, 'statusIuranPerTahun') &&
        isOptMap(data, 'riwayatIuranPerTahun') &&
        isOptMap(data, 'riwayatKematianPerTahun') &&
        isOptNum(data, 'iuranUmumTerbayar') &&
        isOptNum(data, 'iuranKematianTerbayar') &&
        (!( 'pilihanSkema' in data ) || data.pilihanSkema == null || (data.pilihanSkema == 'bulanan' || data.pilihanSkema == 'tahunan')) &&
        (!( 'riwayatPerubahanKK' in data ) || data.riwayatPerubahanKK == null || (data.riwayatPerubahanKK is list && data.riwayatPerubahanKK.size() <= 50 && (data.riwayatPerubahanKK.size() == 0 || data.riwayatPerubahanKK[0] is map))) &&
        isOptStr(data, 'linkedUid', 128) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'tanggal', 'kategori', 'nominal', 'tipe', 'rt', 'rw', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'tanggal', 'kategori', 'keterangan', 'nominal', 'tipe',
          'residentId', 'namaWarga', 'nomorRumah', 'noKK', 'isSaldoAwal', 'tahun', 'rt', 'rw', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.tanggal, 1, 32) &&
        isValidStr(data.kategori, 1, 120) &&
        isOptStr(data, 'keterangan', 500) &&
        data.nominal is number &&
        (data.tipe == 'masuk' || data.tipe == 'keluar' || data.tipe == 'kematian') &&
        isOptStr(data, 'residentId', 128) &&
        isOptStr(data, 'namaWarga', 160) &&
        isOptStr(data, 'nomorRumah', 32) &&
        isOptStr(data, 'noKK', 32) &&
        isOptBool(data, 'isSaldoAwal') &&
        isOptNum(data, 'tahun') &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'rtScope', 64) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBantuan(data) {
      return data.keys().hasAll(['id', 'jenisBantuan', 'namaPenerima', 'status', 'rt', 'rw', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'jenisBantuan', 'namaPenerima', 'noKK', 'nik', 'nominalAtauBarang',
          'tanggal', 'status', 'sumberDana', 'keterangan', 'rt', 'rw', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.jenisBantuan, 1, 160) &&
        isValidStr(data.namaPenerima, 1, 160) &&
        isOptStr(data, 'noKK', 32) &&
        isOptStr(data, 'nik', 32) &&
        isOptStr(data, 'nominalAtauBarang', 200) &&
        isOptStr(data, 'tanggal', 32) &&
        (data.status == 'Sudah Disalurkan' || data.status == 'Proses Verifikasi' || data.status == 'Baru Diusulkan' || data.status == 'Ditolak') &&
        isOptStr(data, 'sumberDana', 160) &&
        isOptStr(data, 'keterangan', 400) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'rtScope', 64) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPengumuman(data) {
      return data.keys().hasAll(['id', 'judul', 'isi', 'kategori', 'tanggal', 'rt', 'rw', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'judul', 'isi', 'kategori', 'tanggal', 'tanggalBerakhir', 'penulis',
          'namaPengurus', 'jabatanPengurus', 'penting', 'tentang',
          'hariTanggalAcara', 'waktuAcara', 'tempatAcara', 'keteranganTambahan', 'rt', 'rw', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.judul, 1, 200) &&
        isValidStr(data.isi, 1, 4000) &&
        (data.kategori == 'Kegiatan' || data.kategori == 'Iuran' || data.kategori == 'Keamanan' || data.kategori == 'Sosial' || data.kategori == 'Umum') &&
        isValidStr(data.tanggal, 1, 32) &&
        isOptStr(data, 'tanggalBerakhir', 32) &&
        isOptStr(data, 'penulis', 120) &&
        isOptStr(data, 'namaPengurus', 120) &&
        isOptStr(data, 'jabatanPengurus', 120) &&
        isOptBool(data, 'penting') &&
        isOptStr(data, 'tentang', 200) &&
        isOptStr(data, 'hariTanggalAcara', 120) &&
        isOptStr(data, 'waktuAcara', 80) &&
        isOptStr(data, 'tempatAcara', 200) &&
        isOptStr(data, 'keteranganTambahan', 500) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'rtScope', 64) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDokumen(data) {
      return data.keys().hasAll(['id', 'judul', 'namaFile', 'kategori', 'rt', 'rw', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'judul', 'namaFile', 'ukuranKb', 'tanggalUpload', 'kategori',
          'keterangan', 'dataBase64', 'rt', 'rw', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.judul, 1, 200) &&
        isValidStr(data.namaFile, 1, 200) &&
        isOptNum(data, 'ukuranKb') &&
        isOptStr(data, 'tanggalUpload', 32) &&
        isValidStr(data.kategori, 1, 80) &&
        isOptStr(data, 'keterangan', 300) &&
        isOptStr(data, 'dataBase64', 850000) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'rtScope', 64) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRTAccount(data) {
      return data.keys().hasAll(['id', 'username', 'passwordHash', 'nama', 'rt', 'rw', 'status', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'username', 'passwordHash', 'nama', 'rt', 'rw', 'rtId', 'rwId', 'kontak', 'jabatan',
          'status', 'terakhirLogin', 'terakhirSinkronisasi', 'authUid',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.username, 1, 80) &&
        isValidStr(data.passwordHash, 1, 128) &&
        isValidStr(data.nama, 1, 160) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'kontak', 40) &&
        isOptStr(data, 'jabatan', 120) &&
        (data.status == 'aktif' || data.status == 'nonaktif') &&
        isOptStr(data, 'terakhirLogin', 64) &&
        isOptStr(data, 'terakhirSinkronisasi', 64) &&
        isOptStr(data, 'authUid', 128) &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLaporanBulanan(data) {
      return data.keys().hasAll(['id', 'rt', 'rw', 'bulanTahun', 'statusVerifikasi', 'accessUids', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'rt', 'rw', 'rtId', 'rwId', 'namaAdminPengirim', 'tanggalKirim', 'bulanTahun', 'tahun',
          'totalKK', 'totalJiwa', 'totalLunasIuran', 'totalBelumLunas',
          'totalKasMasukBulanIni', 'totalKasKeluarBulanIni',
          'saldoKasUmumBerjalan', 'saldoKasKematianBerjalan',
          'totalPenerimaBansos', 'catatanKhusus', 'statusVerifikasi',
          'accessUids', 'serverUid', 'rtAdminUid', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidStr(data.rt, 1, 10) &&
        isValidStr(data.rw, 1, 10) &&
        isOptStr(data, 'rtId', 32) &&
        isOptStr(data, 'rwId', 32) &&
        isValidRwRtScope(data) &&
        isOptStr(data, 'namaAdminPengirim', 160) &&
        isOptStr(data, 'tanggalKirim', 32) &&
        isValidStr(data.bulanTahun, 1, 64) &&
        isOptNum(data, 'tahun') &&
        isOptNum(data, 'totalKK') &&
        isOptNum(data, 'totalJiwa') &&
        isOptNum(data, 'totalLunasIuran') &&
        isOptNum(data, 'totalBelumLunas') &&
        isOptNum(data, 'totalKasMasukBulanIni') &&
        isOptNum(data, 'totalKasKeluarBulanIni') &&
        isOptNum(data, 'saldoKasUmumBerjalan') &&
        isOptNum(data, 'saldoKasKematianBerjalan') &&
        isOptNum(data, 'totalPenerimaBansos') &&
        isOptStr(data, 'catatanKhusus', 500) &&
        (data.statusVerifikasi == 'Diterima' || data.statusVerifikasi == 'Menunggu Verifikasi' || data.statusVerifikasi == 'Perlu Klarifikasi') &&
        isValidAccessUids(data) &&
        isOptStr(data, 'serverUid', 128) &&
        isOptStr(data, 'rtAdminUid', 128) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Connection test probe (signed-in users only, no public read)
    match /test/{testId} {
      allow get: if isValidId(testId) && testId == 'connection' && isSignedIn();
      allow read, write: if false;
    }

    // Collection: /systemMeta/{metaId} (One-time server bootstrap lock & pin policy)
    match /systemMeta/{metaId} {
      allow get: if isValidId(metaId) && isSignedIn();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(metaId) &&
        isSignedIn() &&
        isValidSystemMeta(incoming()) &&
        ('rwId' in incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            metaId == 'serverLock' &&
            incoming().id == 'serverLock' &&
            !exists(/databases/$(database)/documents/systemMeta/serverLock) &&
            incoming().serverUid == request.auth.uid &&
            (('bootstrapDigest' in incoming()) && isValidServerBootstrapDigest(incoming().bootstrapDigest))
          ) ||
          (
            metaId == 'pinPolicy' &&
            incoming().id == 'pinPolicy' &&
            isServerInRW(incoming().rw)
          )
        );
      allow update: if isValidId(metaId) &&
        isSignedIn() &&
        isValidSystemMeta(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isServerInRW(existing().rw) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['serverUid', 'rw', 'rwId', 'bootstrapDigest', 'updatedAt']);
      allow delete: if isValidId(metaId) && isBootstrappedAdmin();
    }

    // Collection: /admins/{uid}
    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (
        request.auth.uid == uid ||
        isBootstrappedAdmin() ||
        (resource == null && isActiveAdmin()) ||
        (resource != null && isServerInRW(existing().rw))
      );
      allow list: if isBootstrappedAdmin() || (
        isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.ownerUid == request.auth.uid)
      );
      allow create: if isValidId(uid) &&
        isSignedIn() &&
        isValidAdminUser(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().uid == uid &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          // Bootstrapped Google Admin or existing RW Server creating an Admin RT
          isBootstrappedAdmin() ||
          (incoming().role == 'admin' && isServerInRW(incoming().rw)) ||
          // One-time Master Server bootstrap bound atomically to /systemMeta/serverLock
          (
            incoming().role == 'server' &&
            uid == request.auth.uid &&
            incoming().rt == 'SEMUA' &&
            getAfter(/databases/$(database)/documents/systemMeta/serverLock).data.serverUid == request.auth.uid
          ) ||
          // Admin RT registration via verified 6-digit Pengurus PIN (never role=='server')
          (
            incoming().role == 'admin' &&
            uid == request.auth.uid &&
            incoming().rt != 'SEMUA' &&
            !exists(/databases/$(database)/documents/admins/$(uid)) &&
            ('pinDigest' in incoming()) &&
            isValidPinDigest(incoming().pinDigest)
          )
        );
      allow update: if isValidId(uid) &&
        isSignedIn() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isServerInRW(existing().rw) &&
            sameCode(incoming().rw, existing().rw) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'username', 'role', 'rt', 'rw', 'rtId', 'rwId', 'rtScope', 'status', 'updatedAt'])
          ) ||
          (
            request.auth.uid == uid &&
            incoming().role == existing().role &&
            incoming().rw == existing().rw &&
            incoming().rt == existing().rt &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'rwId', 'rtId', 'updatedAt'])
          )
        );
      allow delete: if isValidId(uid) && isSignedIn() && (
        (resource == null && isServerAnyRW()) ||
        (resource != null && isServerInRW(existing().rw))
      );
    }

    // Collection: /wargaProfiles/{uid}
    match /wargaProfiles/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (
        request.auth.uid == uid ||
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnerScoped() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(uid) &&
        isSignedIn() &&
        isValidWargaProfile(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().uid == uid &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(uid) &&
        isSignedIn() &&
        isValidWargaProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        isAssignedAdmin(incoming().rw, incoming().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['wargaId', 'noKK', 'nama', 'rt', 'rw', 'rtId', 'rwId', 'serverUid', 'updatedAt']);
      allow delete: if isValidId(uid) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /rtRegistry/{rwId}
    match /rtRegistry/{rwId} {
      allow get: if isValidId(rwId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isActiveAdminInRW(existing().rw))
      );
      allow list: if canListOwnerScoped();
      allow create: if isValidId(rwId) &&
        isSignedIn() &&
        isValidRtRegistry(incoming()) &&
        ('rwId' in incoming()) &&
        incoming().id == rwId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isActiveAdminInRW(incoming().rw);
      allow update: if isValidId(rwId) &&
        isSignedIn() &&
        isValidRtRegistry(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isActiveAdminInRW(existing().rw) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['serverUid', 'adminsByRt', 'registeredRts', 'rwId', 'updatedAt']);
      allow delete: if isValidId(rwId) && isSignedIn() && (
        (resource == null && isServerAnyRW()) ||
        (resource != null && isServerInRW(existing().rw))
      );
    }

    // Collection: /rtManifest/{scopeId}
    match /rtManifest/{scopeId} {
      allow get: if isValidId(scopeId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnerScoped();
      allow create: if isValidId(scopeId) &&
        isSignedIn() &&
        isValidRtManifest(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == scopeId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(scopeId) &&
        isSignedIn() &&
        isValidRtManifest(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().rt == existing().rt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['docIds', 'serverUid', 'rwId', 'rtId', 'updatedAt']);
      allow delete: if isValidId(scopeId) && isSignedIn() && (
        (resource == null && isServerAnyRW()) ||
        (resource != null && isServerInRW(existing().rw))
      );
    }

    // Collection: /rtPublicSummaries/{scopeId}
    match /rtPublicSummaries/{scopeId} {
      allow get: if isValidId(scopeId) && isSignedIn() && (
        (resource == null && (isActiveAdmin() || hasWargaProfile())) ||
        (resource != null && (isAssignedAdmin(existing().rw, existing().rt) || isWargaInRWRT(existing().rw, existing().rt)))
      );
      allow list: if canListOwnerScoped();
      allow create: if isValidId(scopeId) &&
        isSignedIn() &&
        isValidRtPublicSummary(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == scopeId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(scopeId) &&
        isSignedIn() &&
        isValidRtPublicSummary(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().rt == existing().rt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['tahunAktif', 'pengaturanKas', 'transactions', 'pengumuman', 'serverUid', 'rwId', 'rtId', 'updatedAt']);
      allow delete: if isValidId(scopeId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /settings/{settingId}
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn() && (
        (resource == null && (isActiveAdmin() || hasWargaProfile())) ||
        (resource != null && (isAssignedAdminReadSetting(existing().rw, existing().rt) || isWargaInRWRT(existing().rw, existing().rt)))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(settingId) &&
        isSignedIn() &&
        isValidAppSettings(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == settingId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(settingId) &&
        isSignedIn() &&
        isValidAppSettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        isAssignedAdmin(incoming().rw, incoming().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'rt', 'rtId', 'rwId', 'tahunAktif', 'nominalJimpitanTahunan', 'nominalJimpitanBulanan',
          'nominalKematianTahunan', 'nominalKematianBulanan',
          'saldoAwalKasUmum', 'saldoAwalKasKematian',
          'keteranganSaldoAwal', 'tanggalSaldoAwal',
          'kontakKetuaRT', 'kontakBendahara', 'saldoBerlanjutPerTahun', 'profilRT',
          'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
        ]);
      allow delete: if isValidId(settingId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /warga/{wargaId} (PII restricted to assigned RW/RT Admins or linked resident owner)
    match /warga/{wargaId} {
      allow get: if isValidId(wargaId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && (isAssignedAdmin(existing().rw, existing().rt) || existing().linkedUid == request.auth.uid))
      );
      allow list: if canListOwnOrScoped() || (
        isSignedIn() && resource.data.linkedUid == request.auth.uid
      );
      allow create: if isValidId(wargaId) &&
        isSignedIn() &&
        isValidWarga(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == wargaId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(wargaId) &&
        isSignedIn() &&
        isValidWarga(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAssignedAdmin(existing().rw, existing().rt) &&
            isAssignedAdmin(incoming().rw, incoming().rt) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'no', 'nama', 'noKK', 'nik', 'noRumah', 'rt', 'rtId', 'rwId', 'alamat',
              'kodePos', 'tanggalDikeluarkan', 'jenisKelamin', 'jumlahJiwa', 'statusIuran',
              'anggotaKeluarga', 'telepon', 'pin', 'pinAttempts', 'pinLockedUntil',
              'riwayatIuran', 'riwayatKematian', 'statusIuranPerTahun', 'riwayatIuranPerTahun',
              'riwayatKematianPerTahun', 'iuranUmumTerbayar', 'iuranKematianTerbayar',
              'pilihanSkema', 'riwayatPerubahanKK', 'linkedUid',
              'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
            ])
          ) ||
          (
            existing().linkedUid == request.auth.uid &&
            incoming().rt == existing().rt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'telepon', 'updatedAt'])
          )
        );
      allow delete: if isValidId(wargaId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /transactions/{txId}
    match /transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(txId) &&
        isSignedIn() &&
        isValidTransaction(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == txId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(txId) &&
        isSignedIn() &&
        isValidTransaction(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        isAssignedAdmin(incoming().rw, incoming().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'tanggal', 'kategori', 'keterangan', 'nominal', 'tipe',
          'residentId', 'namaWarga', 'nomorRumah', 'noKK', 'isSaldoAwal', 'tahun', 'rt', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
        ]);
      allow delete: if isValidId(txId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /bantuan/{bantuanId} (Confidential UU PDP - Assigned RW/RT Admin only)
    match /bantuan/{bantuanId} {
      allow get: if isValidId(bantuanId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(bantuanId) &&
        isSignedIn() &&
        isValidBantuan(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == bantuanId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(bantuanId) &&
        isSignedIn() &&
        isValidBantuan(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        isAssignedAdmin(incoming().rw, incoming().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'jenisBantuan', 'namaPenerima', 'noKK', 'nik', 'nominalAtauBarang',
          'tanggal', 'status', 'sumberDana', 'keterangan', 'rt', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
        ]);
      allow delete: if isValidId(bantuanId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /pengumuman/{pengumumanId}
    match /pengumuman/{pengumumanId} {
      allow get: if isValidId(pengumumanId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdminReadSetting(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(pengumumanId) &&
        isSignedIn() &&
        isValidPengumuman(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == pengumumanId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isServerInRW(incoming().rw) || isAssignedAdmin(incoming().rw, incoming().rt));
      allow update: if isValidId(pengumumanId) &&
        isSignedIn() &&
        isValidPengumuman(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isServerInRW(existing().rw) && isServerInRW(incoming().rw)) ||
          (isAssignedAdmin(existing().rw, existing().rt) && isAssignedAdmin(incoming().rw, incoming().rt))
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'judul', 'isi', 'kategori', 'tanggal', 'tanggalBerakhir', 'penulis',
          'namaPengurus', 'jabatanPengurus', 'penting', 'tentang',
          'hariTanggalAcara', 'waktuAcara', 'tempatAcara', 'keteranganTambahan', 'rt', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
        ]);
      allow delete: if isValidId(pengumumanId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && (isServerInRW(existing().rw) || isAssignedAdmin(existing().rw, existing().rt)))
      );
    }

    // Collection: /dokumen/{dokumenId} (Assigned RW/RT Admin only)
    match /dokumen/{dokumenId} {
      allow get: if isValidId(dokumenId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(dokumenId) &&
        isSignedIn() &&
        isValidDokumen(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == dokumenId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(dokumenId) &&
        isSignedIn() &&
        isValidDokumen(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(existing().rw, existing().rt) &&
        isAssignedAdmin(incoming().rw, incoming().rt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'judul', 'namaFile', 'ukuranKb', 'tanggalUpload', 'kategori',
          'keterangan', 'dataBase64', 'rt', 'rtId', 'rwId', 'rtScope',
          'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
        ]);
      allow delete: if isValidId(dokumenId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
    }

    // Collection: /adminAccounts/{accountId}
    match /adminAccounts/{accountId} {
      allow get: if isValidId(accountId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(accountId) &&
        isSignedIn() &&
        isValidAdminRTAccount(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == accountId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isServerInRW(incoming().rw) ||
          (isAssignedAdmin(incoming().rw, incoming().rt) && ('authUid' in incoming()) && incoming().authUid == request.auth.uid)
        );
      allow update: if isValidId(accountId) &&
        isSignedIn() &&
        isValidAdminRTAccount(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isServerInRW(existing().rw) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'passwordHash', 'nama', 'rt', 'rw', 'rtId', 'rwId', 'kontak', 'jabatan',
              'status', 'terakhirLogin', 'terakhirSinkronisasi', 'authUid',
              'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
            ])
          ) ||
          (
            isAssignedAdmin(existing().rw, existing().rt) &&
            incoming().rt == existing().rt &&
            (
              (('authUid' in existing()) && existing().authUid == request.auth.uid) ||
              (!('authUid' in existing()) || existing().authUid == null)
            ) &&
            (!('authUid' in incoming()) || incoming().authUid == null || incoming().authUid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nama', 'kontak', 'jabatan', 'rtId', 'rwId', 'authUid',
              'terakhirLogin', 'terakhirSinkronisasi', 'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(accountId) && isSignedIn() && (
        (resource == null && isServerAnyRW()) ||
        (resource != null && isServerInRW(existing().rw))
      );
    }

    // Collection: /laporanBulanan/{laporanId}
    match /laporanBulanan/{laporanId} {
      allow get: if isValidId(laporanId) && isSignedIn() && (
        (resource == null && isActiveAdmin()) ||
        (resource != null && isAssignedAdmin(existing().rw, existing().rt))
      );
      allow list: if canListOwnOrScoped();
      allow create: if isValidId(laporanId) &&
        isSignedIn() &&
        isValidLaporanBulanan(incoming()) &&
        hasRequiredScopeIds(incoming()) &&
        incoming().id == laporanId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAssignedAdmin(incoming().rw, incoming().rt);
      allow update: if isValidId(laporanId) &&
        isSignedIn() &&
        isValidLaporanBulanan(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().rw == existing().rw &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isServerInRW(existing().rw) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'rt', 'rtId', 'rwId', 'namaAdminPengirim', 'tanggalKirim', 'bulanTahun', 'tahun',
              'totalKK', 'totalJiwa', 'totalLunasIuran', 'totalBelumLunas',
              'totalKasMasukBulanIni', 'totalKasKeluarBulanIni',
              'saldoKasUmumBerjalan', 'saldoKasKematianBerjalan',
              'totalPenerimaBansos', 'catatanKhusus', 'statusVerifikasi',
              'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
            ])
          ) ||
          (
            isAssignedAdmin(existing().rw, existing().rt) &&
            incoming().rt == existing().rt &&
            incoming().statusVerifikasi == existing().statusVerifikasi &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'rtId', 'rwId', 'namaAdminPengirim', 'tanggalKirim', 'bulanTahun', 'tahun',
              'totalKK', 'totalJiwa', 'totalLunasIuran', 'totalBelumLunas',
              'totalKasMasukBulanIni', 'totalKasKeluarBulanIni',
              'saldoKasUmumBerjalan', 'saldoKasKematianBerjalan',
              'totalPenerimaBansos', 'catatanKhusus',
              'accessUids', 'serverUid', 'rtAdminUid', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(laporanId) && isSignedIn() && (
        (resource == null && isServerAnyRW()) ||
        (resource != null && isServerInRW(existing().rw))
      );
    }
  }
}
